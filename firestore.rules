rules_version = '2';
// テンプレート：本物のUIDはここに書かず、setup.html で作成してFirebaseコンソールに貼り付ける。
// プレースホルダのままでは誰にも一致しないため、このファイル自体は全アクセス拒否と同じ。
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理者1人のUID＋「家族の名簿」に載ったGoogleアカウントだけを許可
    // （このルールはFirebaseコンソールにのみ保存し、GitHubには載せない）
    function owner() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_OWNER_UID';
    }
    function member() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/familyMembers/$(request.auth.token.email.lower()));
    }
    function family() {
      return owner() || member();
    }
    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 60;
    }
    function validItem(d) {
      return d.keys().hasAll(['name', 'quantity', 'done', 'createdAt', 'doneAt'])
        && d.keys().hasOnly(['name', 'quantity', 'done', 'createdAt', 'doneAt'])
        && validName(d.name)
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 999
        && d.done is bool
        && (d.createdAt is int || d.createdAt is timestamp)
        && (d.doneAt == null || d.doneAt is int || d.doneAt is timestamp);
    }
    match /shoppingItems/{itemId} {
      allow read, delete: if family();
      allow create, update: if family() && validItem(request.resource.data);
    }
    match /shoppingFavorites/{favId} {
      allow read, delete: if family();
      allow create, update: if family()
        && request.resource.data.keys().hasOnly(['name'])
        && validName(request.resource.data.name);
    }
    // 家族の名簿：見るのは家族、変更できるのは管理者だけ
    match /familyMembers/{memberEmail} {
      allow read: if family();
      allow create, update: if owner()
        && memberEmail == memberEmail.lower()
        && memberEmail.matches('^[^@/]+@[^@/]+$')
        && request.resource.data.keys().hasOnly(['addedAt']);
      allow delete: if owner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
